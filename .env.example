# Dental Daysheet settings. Copy this file to .env and fill it in.
# Never commit .env, and never paste its values into GitHub, email or chat.

# design = Hostinger + Open Dental demo database (now); live = office server (later)
TDC_STAGE=design

# Port to listen on. Live stage: 3101. On Hostinger leave PORT out (Hostinger sets it).
PORT=3101

# Design stage on Hostinger only: HOST=0.0.0.0 so Hostinger can reach the app.
# Leave it out on your own computer and on the office server (127.0.0.1).
# HOST=0.0.0.0

# From Dashboard → Settings → Modules → Add a module (id "daysheet"). 64 hex characters.
MODULE_SECRET=

# The Open Dental gateway.
#   Building on a laptop:  http://127.0.0.1:8787 (npm run dev in opendental-claude)
#   Design stage:          the office gateway's tunnel address, https://...
#   Live stage:            http://127.0.0.1:8787
GATEWAY_URL=http://127.0.0.1:8787

# This module's own gateway key (made with: node gateway/cli.js new-key daysheet).
# For the laptop demo gateway, use the test key it prints for "daysheet".
GATEWAY_KEY=

# Office time zone, for "today".
OFFICE_TZ=America/Los_Angeles

# Days the office sees patients (0 = Sunday ... 6 = Saturday). On other days
# "Today" shows the next clinic day. Toledo Dental Care: 1,2,3,4
CLINIC_DAYS=1,2,3,4,5

# When x-rays are due (months since the last one). FMX every 60 months,
# bitewings every 12 months unless an FMX was taken in that time.
XRAY_FMX_MONTHS=60
XRAY_BWX_MONTHS=12

# Insurance left below this amount shows amber.
INSURANCE_LOW=500
